# Database Configuration
# Railway will automatically provide DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION

# Cloudflare R2 Configuration (for EXE file hosting)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=partnerchain-releases

# Application Settings
DEBUG=False
ENVIRONMENT=production

# CORS Origins (comma-separated)
# Add your deployed frontend URL here
ALLOWED_ORIGINS=https://your-frontend.up.railway.app,https://your-custom-domain.com

# Current Application Version (for auto-update system)
CURRENT_VERSION=1.0.0
RELEASE_DATE=2026-02-07
